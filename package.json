{
  "name": "azaka-api",
  "version": "1.0.0",
  "description": "Optional infrastructure backend for Azaka decentralized trade finance protocol - handles document storage, notifications, and indexed queries",
  "main": "dist/index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "indexer": "tsx watch src/indexer/index.ts",
    "api": "tsx watch src/api/index.ts",
    "build": "tsc",
    "start:api": "node dist/api/index.js",
    "start:indexer": "node dist/indexer/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "bash scripts/test-api.sh",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "stellar",
    "soroban",
    "trade-finance",
    "blockchain",
    "indexer"
  ],
  "author": "Azaka",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "@stellar/stellar-sdk": "^11.3.0",
    "bullmq": "^5.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "resend": "^3.2.0",
    "zod": "^3.22.4",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "prisma": "^5.11.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
